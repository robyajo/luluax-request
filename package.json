{
  "name": "luluax-request",
  "version": "1.0.0",
  "description": "Modern API Client inspired by Requestly with Neon Cloud Sync for Windows & macOS",
  "main": "electron-main.js",
  "scripts": {
    "start": "node server.js",
    "dev:win": "dev-win.bat",
    "dev:mac": "bash dev-mac.sh",
    "dev:portable": "electron-builder --win portable --publish never",
    "build:portable": "electron-builder --win portable --publish never",
    "build:installer": "electron-builder --win nsis --publish never",
    "build:mac-dmg": "electron-builder --mac dmg --arm64 --publish never",
    "build:mac-app": "electron-builder --mac dir --arm64 --publish never",
    "build:win": "build-win.bat",
    "build:mac": "bash build-mac.sh"
  },
  "keywords": [
    "luluax-request",
    "api-client",
    "requestly",
    "http-client",
    "rest",
    "neon",
    "hono"
  ],
  "author": "LuluaX",
  "license": "MIT",
  "dependencies": {
    "dotenv": "^18.0.8",
    "express": "^4.21.2"
  },
  "build": {
    "appId": "com.luluax.request",
    "productName": "LuluaX-Request",
    "npmRebuild": false,
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "LuluaX-Request",
      "uninstallDisplayName": "LuluaX-Request Uninstall"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools"
    }
  },
  "devDependencies": {
    "electron": "^44.9.2",
    "electron-builder": "^26.15.3"
  }
}

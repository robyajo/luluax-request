{
  "name": "luluax-request",
  "version": "1.0.3",
  "description": "Modern API Client inspired by Requestly with Neon Cloud Sync for Windows & macOS",
  "main": "dist-electron/main.js",
  "scripts": {
    "build": "tsc",
    "start": "tsc && node dist-electron/server.js",
    "dev:win": "tsc && dev-win.bat",
    "dev:mac": "tsc && bash dev-mac.sh",
    "dev:portable": "tsc && electron-builder --win portable --publish never",
    "build:portable": "tsc && electron-builder --win portable --publish never",
    "build:installer": "tsc && electron-builder --win nsis --publish never",
    "build:mac-dmg": "tsc && electron-builder --mac dmg --arm64 --publish never",
    "build:mac-app": "tsc && electron-builder --mac dir --arm64 --publish never",
    "build:win": "build-win.bat",
    "build:mac": "bash build-mac.sh"
  },
  "keywords": [
    "luluax-request",
    "api-client",
    "requestly",
    "http-client",
    "rest",
    "neon",
    "hono"
  ],
  "author": "LuluaX",
  "license": "MIT",
  "dependencies": {
    "dotenv": "^18.0.8",
    "electron-updater": "^6.8.9",
    "express": "^4.21.2"
  },
  "build": {
    "appId": "com.luluax.request",
    "productName": "LuluaX-Request",
    "publish": {
      "provider": "github",
      "owner": "robyajo",
      "repo": "luluax-request"
    },
    "npmRebuild": false,
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "LuluaX-Request",
      "uninstallDisplayName": "LuluaX-Request Uninstall"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools"
    }
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "electron": "^44.9.2",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2"
  }
}
